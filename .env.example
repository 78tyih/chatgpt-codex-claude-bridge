# Copy to .env and fill in. NEVER commit the real .env.

# Path-secret (capability URL). MUST be plain hex — special chars get
# normalized away by some clients. Generate with: python -c "import secrets;print(secrets.token_hex(24))"
BRIDGE_PATH_SECRET=

# Optional Bearer token. Only works with clients that can send custom
# headers (ChatGPT Plus dev-mode connectors CANNOT — use path-secret instead).
BRIDGE_TOKEN=

# Where the file tools are allowed to read/write. Defaults to $HOME.
BRIDGE_WORK_ROOT=

# Absolute paths to the real CLI binaries (not shell function wrappers).
CODEX_BIN=
CLAUDE_BIN=

# Per-task timeout in seconds (default 600).
CODEX_TIMEOUT=600

# Comma-separated host allowlist. Leave empty to disable DNS-rebinding
# protection (access control then relies on the secret URL).
BRIDGE_ALLOWED_HOSTS=
